[AWS]
# Get your AWS credentials from: https://console.aws.amazon.com/iam/home#/security_credentials
# Create an IAM user with the following permissions:
# - AmazonBedrockFullAccess
# - AmazonDynamoDBFullAccess
# - AmazonIoTCoreFullAccess
# - CloudWatchFullAccess
# - AmazonOpenSearchServiceFullAccess

aws_access_key_id = YOUR_AWS_ACCESS_KEY_ID
aws_secret_access_key = YOUR_AWS_SECRET_ACCESS_KEY
aws_region = us-east-1

# DynamoDB table names (will be created automatically)
dynamodb_table_users = find-your-team-users
dynamodb_table_teams = find-your-team-teams
dynamodb_table_integrations = find-your-team-integrations

# Bedrock model configuration
bedrock_model_id = anthropic.claude-3-5-sonnet-20240620-v1:0
bedrock_region = us-east-1

# OpenSearch configuration
opensearch_domain_name = find-your-team-search
opensearch_region = us-east-1

# IoT Core configuration
iot_endpoint = YOUR_IOT_ENDPOINT.amazonaws.com
iot_topic_prefix = find-your-team/

[APP]
# Application settings
debug = false
host = 0.0.0.0
port = 5000

# Security settings (generate random strings)
secret_key = YOUR_RANDOM_SECRET_KEY_HERE
session_secret = YOUR_RANDOM_SESSION_SECRET_HERE

[AGENTS]
# Agent configuration
onboarding_agent_enabled = true
matching_agent_enabled = true
team_agent_enabled = true
integration_agent_enabled = true

# Agent timeouts (in seconds)
agent_timeout = 30
max_retries = 3 
